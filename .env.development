# ========================================
# Variables de Entorno - DESARROLLO
# ========================================

# Base de datos
POSTGRES_DB=inventario
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_PORT=5432

# Backend
JWT_SECRET_KEY=development-secret-key-not-for-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API URL (desarrollo local)
REACT_APP_API_URL=http://localhost:8000

# Puertos
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Modo desarrollo: monta código fuente y usa hot-reload
BACKEND_VOLUMES=./backend:/app
BACKEND_COMMAND=python -m uvicorn main:app --host 0.0.0.0 --port 8000 --reload

# Logs
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
