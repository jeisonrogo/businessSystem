# ========================================
# Variables de Entorno - PRODUCCIÓN VPS
# Copia este archivo como .env en el VPS
# ========================================

# Base de datos
POSTGRES_DB=inventario
POSTGRES_USER=admin
# IMPORTANTE: Genera una contraseña segura con: openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD_HERE
POSTGRES_PORT=5432

# Backend
# IMPORTANTE: Genera una clave JWT segura con: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS - Orígenes permitidos (formato JSON array)
# IMPORTANTE: Cambiar a la IP o dominio de tu VPS
CORS_ORIGINS=["http://your-vps-ip:3000","http://localhost:3000"]

# API URL - CAMBIAR A LA IP O DOMINIO DE TU VPS
REACT_APP_API_URL=http://your-vps-ip:8000

# Puertos
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Logs
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

# ========================================
# Variables para deploy-to-vps.sh (solo en tu máquina local)
# ========================================
VPS_HOST=ubuntu@your-vps-ip-here
VPS_PATH=/home/ubuntu/businessSystem
